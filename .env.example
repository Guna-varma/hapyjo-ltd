# ---------------------------------------------------------------------------
# Marketing website
# ---------------------------------------------------------------------------
# Contact form – submissions are sent to the email you set in the form service.
# Formspree (recommended): sign up at https://formspree.io, create a form,
# set the notification email to your company email, then paste the endpoint below.
VITE_CONTACT_FORM_ACTION=https://formspree.io/f/YOUR_FORM_ID

# ---------------------------------------------------------------------------
# Field Operations app (/app)
# ---------------------------------------------------------------------------
# The SAME Supabase project the mobile app uses. Only these two browser-safe
# values may be exposed to client code — Vite inlines every VITE_* variable into
# the JS bundle, so anything secret must never be named VITE_*.
#
# The anon key is designed to be public; Row Level Security is what protects the
# data. NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or in any VITE_* variable:
# it bypasses RLS entirely. Privileged operations (creating users, resetting
# passwords) go through the existing Supabase Edge Functions, which hold that key
# server-side.
VITE_SUPABASE_URL=https://dobfzbdwyimicxzcssiw.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Contact API (server-side only — not exposed to the browser)
# ---------------------------------------------------------------------------
# Used by api/send-contact.ts (no VITE_ prefix, so these stay server-side).
# Messages are delivered to SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
